{"version": 2, "width": 160, "height": 40, "timestamp": 1792383566, "title": "pipeline interrupt/resume demo - run 'full'", "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.0, "o", "\r\n\u001b[1;36m# Interrupt/resume demo, recorded 2026-10-18 21:19:26 PDT on the real pipeline and real APIs\u001b[0m\r\n"]
[0.0, "o", "\r\n\u001b[1;36m# 1. Saved state before the run\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m python -m pipeline status --run full\r\n"]
[0.087, "o", "{\r\r\n \"completed\": 0,\r\r\n \"pending\": 660609,\r\r\n \"quarantined\": 13,\r\r\n \"spent_usd\": 0,\r\r\n \"calls\": 0,\r\r\n \"invocations\": [\r\r\n  {\r\r\n   \"invocation\": 1,\r\r\n   \"phase\": \"initial\",\r\r\n   \"status\": \"completed\",\r\r\n   \"completed_before\": 0,\r\r\n   \"completed_after\": 0\r\r\n  }\r\r\n ]\r\r\n}\r\r\n"]
[0.094, "o", "\r\n\u001b[1;36m# 2. Start enrichment. SIGINT (= Ctrl-C) is sent as soon as the first Message Batch has been collected and saved\u001b[0m\r\n"]
[0.094, "o", "\u001b[1;32m$\u001b[0m python -m pipeline run --input data/raw/spotify_reviews_18months.csv --run full --stages enrich --workers 8 --batch-requests 200 --budget-usd 4.40\r\n"]
[0.13, "o", "[2026-10-18 21:19:26] === invocation 2 (initial) run=full stages=['enrich'] opts={'batch_size': 50, 'transport': 'batch', 'batch_requests': 200, 'poll_seconds': 20, 'workers': 8, 'jev_rps': 8.0, 'jev_concurrency': 16, 'budget_usd': 4.4, 'max_attempts': 4, 'max_minutes': 0, 'verify_sample': 200, 'verify_seed': 'verify-seed-v1'}\r\r\n"]
